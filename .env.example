# Contact backend settings (see README → "Contact form and inbox").
# On Vercel, set these under Settings → Environment Variables instead.

# Postgres connection string. Connecting a Neon database in Vercel sets this for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Your login for /inbox. Use a long password you don't use anywhere else.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Optional: email me about each new message (https://resend.com).
RESEND_API_KEY=
NOTIFY_EMAIL=

# Optional: use a backend hosted somewhere else instead of this site's /api.
VITE_BACKEND_URL=
